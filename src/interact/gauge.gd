class_name Gauge
extends Node3D
## In-world dial instrument. The needle sweeps [member sweep_deg] across
## [member min_value]..[member max_value] of a readout on the node in the
## `sub_readouts` group. A gauge is one node: it builds itself in [method _ready].
##
## The shape is shared: the bezel, hub, title plate and needle are solids
## generated by `tools/cadkit/scenes/gauge.py`, instanced here and scaled
## to [member radius]. Change them there and every gauge in the game follows.
## What differs from one gauge to the next is an export below.

## Reference radius of the generated solids (m).
const SOLID_RADIUS: float = 0.1
const BODY: PackedScene = preload("res://assets/models/kit/gauge/gauge_body.glb")
const NEEDLE: PackedScene = preload("res://assets/models/kit/gauge/gauge_needle.glb")

## Group of the node that provides `readout(name) -> float`.
@export var source_group: StringName = &"sub_readouts"
@export var readout: StringName = &"depth"
## Optional second needle (e.g. ocean background on the noise gauge).
@export var readout_b: StringName = &""
@export var title: String = "DEPTH"
@export var min_value: float = 0.0
@export var max_value: float = 100.0
@export var sweep_deg: float = 270.0
## Where the middle of the scale points, in degrees clockwise from straight up.
## 0 keeps the scale symmetric about the top; 90 puts its middle at 3 o'clock.
@export var sweep_center_deg: float = 0.0
## Labels drawn at the ends and middle of the scale.
@export var show_scale: bool = true
@export var radius: float = 0.12
## Wraps the value around the dial (compass).
@export var wraps: bool = false
## Labels at 0°, 90°, 180°, 270° on a wrapping dial.
@export var wrap_labels: PackedStringArray = ["N", "E", "S", "W"]
## Needle smoothing (1/s); gauges have mechanical lag.
@export var needle_response: float = 6.0
## Long tick marks split the scale into this many parts (a wrapping dial has 4).
@export var major_divisions: int = 4
## Short tick marks between two long ones.
@export var minor_per_division: int = 1
@export var face_color: Color = Color(0.03, 0.06, 0.07)
@export var marking_color: Color = Color(0.88, 0.9, 0.86)
@export var needle_color: Color = Color(0.95, 0.95, 0.9)
## Light enough in red to show under the red lamps, at about half the first needle's brightness.
@export var needle_b_color: Color = Color(0.45, 0.75, 1.0)

var _needle: Node3D
var _needle_b: Node3D
var _source: Node
var _shown: float = 0.0
var _shown_b: float = 0.0


func _ready() -> void:
	_build()


func _process(delta: float) -> void:
	if _source == null or not is_instance_valid(_source):
		_source = get_tree().get_first_node_in_group(source_group)
		if _source == null:
			return
	var w: float = 1.0 - exp(-needle_response * delta)
	var v: float = float(_source.call(&"readout", readout))
	if wraps:
		var t_wrap: float = fposmod(v - min_value, max_value - min_value) / (max_value - min_value)
		_shown = lerp_angle(_shown, t_wrap * TAU, w)
		_needle.rotation.z = -_shown
		return
	_shown = lerpf(_shown, _fraction(v), w)
	_needle.rotation.z = _angle_for(_shown)
	if _needle_b != null:
		_shown_b = lerpf(_shown_b, _fraction(float(_source.call(&"readout", readout_b))), w)
		_needle_b.rotation.z = _angle_for(_shown_b)


func _fraction(v: float) -> float:
	return clampf(inverse_lerp(min_value, max_value, v), 0.0, 1.0)


## Needle rotation (about +Z, so positive is anticlockwise) at fraction [param t] of the scale.
func _angle_for(t: float) -> float:
	return deg_to_rad(sweep_deg * 0.5 - sweep_center_deg) - deg_to_rad(sweep_deg) * t


## Unit direction on the dial face that a needle at [param angle] points along.
static func _dir(angle: float) -> Vector3:
	return Vector3(-sin(angle), cos(angle), 0.0)


## Labels and the title shrink with small dials (they were one size for every radius).
func _text_scale() -> float:
	return clampf(radius / 0.12, 0.4, 1.25)


func _build() -> void:
	var k: float = radius / SOLID_RADIUS
	var body: Node3D = BODY.instantiate() as Node3D
	body.name = "Body"
	body.scale = Vector3(k, k, 1.0)
	add_child(body)

	# The dial face: its colour is per gauge, so it is drawn here, not baked into the solids.
	var face: MeshInstance3D = MeshInstance3D.new()
	face.name = "Face"
	var face_mesh: CylinderMesh = CylinderMesh.new()
	face_mesh.top_radius = radius * 0.97
	face_mesh.bottom_radius = radius * 0.97
	face_mesh.height = 0.001
	face_mesh.radial_segments = 32
	face_mesh.rings = 1
	var face_mat: StandardMaterial3D = StandardMaterial3D.new()
	face_mat.albedo_color = face_color
	face_mat.roughness = 0.8
	face_mesh.material = face_mat
	face.mesh = face_mesh
	face.rotation.x = PI / 2.0
	face.position.z = -0.0005
	add_child(face)

	var marks: MeshInstance3D = MeshInstance3D.new()
	marks.name = "Marks"
	marks.mesh = _marks_mesh()
	marks.position.z = 0.0004
	add_child(marks)

	if readout_b != &"":
		_needle_b = _make_needle(needle_b_color, 0.003, "NeedleB")
	_needle = _make_needle(needle_color, 0.006, "Needle")
	if not wraps:
		# At rest a needle lies on the start of its scale, wherever that is.
		_needle.rotation.z = _angle_for(0.0)
		if _needle_b != null:
			_needle_b.rotation.z = _angle_for(0.0)

	var s: float = _text_scale()
	# The title sits on the plate under the dial; a long one is shrunk to fit it.
	var title_px: float = 0.0011 * s
	var title_w: float = ThemeDB.fallback_font.get_string_size(title, HORIZONTAL_ALIGNMENT_LEFT, -1, 32).x * title_px
	if title_w > radius * 1.58:
		title_px *= radius * 1.58 / title_w
	var title_label: Label3D = _add_label(title, Vector3(0, -radius * 1.37, -0.0055), title_px)
	title_label.name = "Title"
	if show_scale and not wraps:
		for t: float in [0.0, 0.5, 1.0]:
			_add_label(_fmt(lerpf(min_value, max_value, t)), _dir(_angle_for(t)) * radius * 0.58 + Vector3(0, 0, 0.0012), 0.0009 * s)
	elif wraps:
		for i: int in range(mini(wrap_labels.size(), 4)):
			_add_label(wrap_labels[i], _dir(-float(i) * PI / 2.0) * radius * 0.6 + Vector3(0, 0, 0.0012), 0.0008 * s)


## Tick marks as one flat mesh on the dial face: long ones at the major
## divisions, short ones between. A wrapping dial is marked all the way round.
func _marks_mesh() -> ArrayMesh:
	var st: SurfaceTool = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	st.set_normal(Vector3(0, 0, 1))
	var per: int = maxi(minor_per_division, 0) + 1
	var steps: int = (4 if wraps else maxi(major_divisions, 1)) * per
	var last: int = steps - 1 if wraps else steps
	for i: int in range(last + 1):
		var major: bool = i % per == 0
		var angle: float = -TAU * float(i) / float(steps) if wraps else _angle_for(float(i) / float(steps))
		var out: Vector3 = _dir(angle)
		var side: Vector3 = Vector3(out.y, -out.x, 0.0) * radius * (0.016 if major else 0.008)
		var a: Vector3 = out * radius * (0.76 if major else 0.84)
		var b: Vector3 = out * radius * 0.93
		for p: Vector3 in [a - side, b - side, b + side, a - side, b + side, a + side]:
			st.add_vertex(p)
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.albedo_color = marking_color
	mat.roughness = 0.9
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	st.set_material(mat)
	return st.commit()


func _make_needle(color: Color, z: float, node_name: String) -> Node3D:
	var pivot: Node3D = Node3D.new()
	pivot.name = node_name
	pivot.position = Vector3(0, 0, z)
	add_child(pivot)
	var needle: Node3D = NEEDLE.instantiate() as Node3D
	var k: float = radius / SOLID_RADIUS
	needle.scale = Vector3(k, k, 1.0)
	var mat: StandardMaterial3D = StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.7
	for child: Node in needle.get_children():
		var mi: MeshInstance3D = child as MeshInstance3D
		if mi != null:
			mi.material_override = mat
	pivot.add_child(needle)
	return pivot


func _add_label(text: String, pos: Vector3, pixel: float) -> Label3D:
	var l: Label3D = Label3D.new()
	l.text = text
	l.pixel_size = pixel
	l.position = pos
	l.modulate = marking_color
	l.outline_size = 0
	l.font_size = 32
	add_child(l)
	return l


static func _fmt(v: float) -> String:
	return str(int(v)) if is_equal_approx(v, roundf(v)) else "%.1f" % v
